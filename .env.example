# Copie este arquivo para .env (só para rodar no seu computador).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# Endereço de conexão do Postgres (Supabase ou Neon).
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Senha que a equipe da Troya usa para entrar no sistema.
APP_PASSWORD=troque-esta-senha

# Opcional: chave extra para assinar as sessões. Se trocar, todos precisam entrar de novo.
# AUTH_SECRET=uma-frase-longa-e-aleatoria
